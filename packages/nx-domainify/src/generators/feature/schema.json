{
  "$schema": "https://json-schema.org/schema",
  "$id": "Feature",
  "title": "",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "",
      "$default": {
        "$source": "argv",
        "index": 0
      },
      "x-prompt": "What name would you like to use?"
    },
    "domain": {
      "type": "string",
      "aliases": ["domain", "domainName"],
      "description": "choose the domain project"
    },
    "directory": {
      "type": "string",
      "description": "A directory where the domain library is placed."
    }
  },
  "required": ["name", "domain"]
}
